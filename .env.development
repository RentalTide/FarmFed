REACT_APP_ENV=development
REACT_APP_SHARETRIBE_SDK_TRANSIT_VERBOSE=true

# Local dev only. Required by the server (e.g. initiate-login-as.js reads
# REACT_APP_MARKETPLACE_ROOT_URL); production sets these via hosting env vars.
REACT_APP_MARKETPLACE_ROOT_URL=http://localhost:3000
REACT_APP_MARKETPLACE_NAME=FarmFed

# Homepage design: true = custom FarmFed homepage (hero + featured products),
# false = hosted PageBuilder/CMS landing page. Off for now.
REACT_APP_CUSTOM_LANDING_PAGE=false

